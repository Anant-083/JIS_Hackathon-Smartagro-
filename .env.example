# Required for Gemma chatbot, crop diagnosis, recommendations, alerts, and translation.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMMA_MODEL=gemma-4-26b-a4b-it

# Weather providers
OPENWEATHER_API_KEY=your_openweather_api_key
VISUALCROSSING_API_KEY=your_visualcrossing_api_key

# Optional: Groq is only used for speech-to-text (Whisper).
GROQ_API_KEY=your_groq_api_key

# Optional: data.gov.in Agmarknet market feed
DATA_GOV_API_KEY=your_data_gov_api_key

# Optional app settings
PORT=7860
FLASK_DEBUG=0
LOG_LEVEL=INFO
DIAGNOSIS_LOG_DIR=./runtime/diagnosis
